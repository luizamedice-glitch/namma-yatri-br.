<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splash" android:layout_width="match_parent"
    android:layout_height="match_parent" android:visibility="visible"
    android:background="@color/br_brand_blue">
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/br_splash" android:scaleType="centerCrop"
        android:contentDescription="Alce Yatri Brasil" />
    <!-- ID mantido para os callbacks existentes, sem animação da marca indiana. -->
    <com.airbnb.lottie.LottieAnimationView android:id="@+id/splash_lottie"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:visibility="gone" />
</RelativeLayout>
