          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "input": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 150
                  },
                  "location": {
                    "$ref": "#/components/schemas/Position"
