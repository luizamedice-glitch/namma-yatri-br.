{
  "openapi": "3.1.0",
  "info": {
    "title": "Mobilidade Brasil — API de testes",
    "version": "0.2.0",
    "license": {
      "name": "AGPL-3.0-or-later"
    }
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8080",
      "description": "Ambiente local privado"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Position": {
        "type": "object",
        "properties": {
          "lat": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "lng": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          }
        },
        "required": [
          "lat",
          "lng"
        ]
      },
      "Point": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Position"
          },
          {
            "type": "object",
            "properties": {
              "address": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              }
            },
            "required": [
              "address"
            ]
          }
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      },
      "Credentials": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 10,
            "maxLength": 128
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "Vehicle": {
        "type": "object",
        "properties": {
          "plate": {
            "type": "string",
            "pattern": "^[A-Z]{3}[0-9][A-Z0-9][0-9]{2}$"
          },
          "model": {
            "type": "string"
          },
          "color": {
            "type": "string"
          }
        },
        "required": [
          "plate",
          "model",
          "color"
        ]
      },
      "Registration": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Credentials"
          },
          {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "role": {
                "enum": [
                  "passenger",
                  "driver"
                ]
              },
              "inviteCode": {
                "type": "string"
              },
              "vehicle": {
                "$ref": "#/components/schemas/Vehicle"
              }
            },
            "required": [
              "name",
              "role",
              "inviteCode"
            ]
          }
        ]
      },
      "Session": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "user": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "name": {
                "type": "string"
              },
              "role": {
                "enum": [
                  "passenger",
                  "driver"
                ]
              }
            },
            "required": []
          }
        },
        "required": [
          "token",
          "user"
        ]
      },
      "Route": {
        "type": "object",
        "properties": {
          "distanceMeters": {
            "type": "number"
          },
          "durationSeconds": {
            "type": "number"
          },
          "encodedPolyline": {
            "type": "string"
          },
          "fareCents": {
            "type": "integer"
          }
        },
        "required": [
          "distanceMeters",
          "durationSeconds",
          "encodedPolyline",
          "fareCents"
        ]
      },
      "QuoteInput": {
        "type": "object",
        "properties": {
          "origin": {
            "$ref": "#/components/schemas/Point"
          },
          "destination": {
            "$ref": "#/components/schemas/Point"
          }
        },
        "required": [
          "origin",
          "destination"
        ]
      },
      "Quote": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "origin": {
            "$ref": "#/components/schemas/Point"
          },
          "destination": {
            "$ref": "#/components/schemas/Point"
          },
          "route": {
            "$ref": "#/components/schemas/Route"
          },
          "fareCents": {
            "type": "integer"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": []
      },
      "Ride": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "enum": [
              "searching",
              "accepted",
              "arrived",
              "in_progress",
              "completed",
              "cancelled"
            ]
          },
          "passenger_id": {
            "type": "string"
          },
          "driver_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "passenger_name": {
            "type": "string"
          },
          "driver_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "origin": {
            "$ref": "#/components/schemas/Point"
          },
          "destination": {
            "$ref": "#/components/schemas/Point"
          },
          "route": {
            "$ref": "#/components/schemas/Route"
          },
          "fare_cents": {
            "type": "integer"
          },
          "version": {
            "type": "integer"
          },
          "plate": {
            "type": [
              "string",
              "null"
            ]
          },
          "model": {
            "type": [
              "string",
              "null"
            ]
          },
          "color": {
            "type": [
              "string",
              "null"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "driver_lat": {
            "type": [
              "number",
              "null"
            ]
          },
          "driver_lng": {
            "type": [
              "number",
              "null"
            ]
          },
          "driver_location_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        },
        "required": []
      },
      "Snapshot": {
        "type": "object",
        "properties": {
          "user": {
            "type": "object"
          },
          "available": {
            "type": "boolean"
          },
          "rides": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Ride"
            }
          },
          "offers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Ride"
            }
          }
        },
        "required": []
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Prontidão do backend e PostgreSQL",
        "operationId": "get__health",
        "responses": {
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "default": {
            "description": "Erro de validação, autenticação, estado ou provedor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": []
      }
    },
