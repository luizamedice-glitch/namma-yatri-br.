# Use uma senha alfanumérica aleatória para evitar caracteres reservados na URL PostgreSQL.
POSTGRES_PASSWORD=replace-with-random-local-password
TEST_INVITE_CODE=replace-with-random-invite-at-least-16-characters
GOOGLE_MAPS_SERVER_KEY=
BASE_FARE_CENTS=500
PER_KM_CENTS=200
DRIVER_RADIUS_METERS=5000

# Apenas para desenvolvimento. Não habilitar em produção.
YATRI_DEVELOPMENT_MODE=true
# Gere separadamente com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
YATRI_PASSENGER_DEV_KEY=
YATRI_DRIVER_DEV_KEY=
# Dados do veículo efetivamente usado nos testes; não há veículo pré-inventado.
YATRI_DRIVER_PLATE=
YATRI_DRIVER_MODEL=
YATRI_DRIVER_COLOR=
